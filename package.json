{
  "name": "mumain-translator",
  "version": "2.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build:web": "bun scripts/build-web.ts",
    "dev:web": "bun scripts/dev-web.ts",
    "build:web-static": "bun scripts/build-web-static.ts",
    "preview:web": "bun scripts/build-web-static.ts && VITE_TARGET=web node node_modules/vite/bin/vite.js preview --port 4175",
    "start": "bun scripts/build-web.ts && bun src/server/main.ts",
    "test": "bun test",
    "test:e2e": "bun scripts/build-web.ts && bun tests/e2e/run.ts",
    "test:e2e:web": "bun scripts/build-web-static.ts && bun tests/e2e/web.ts",
    "build": "bun scripts/build-bin.ts",
    "release": "bun scripts/build-bin.ts --out releases",
    "typecheck": "bun scripts/build-web.ts --stub && tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "test:e2e:fallback": "bun scripts/build-web-static.ts && bun tests/e2e/web-fallback.ts",
    "tag": "bun scripts/tag.ts",
    "glossary:build": "bun scripts/glossary-build.ts"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright-core": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@lucide/vue": "1.48.0",
    "@tanstack/vue-virtual": "3.13.39",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "pinia": "4.0.3",
    "reka-ui": "2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-sonner": "^2.0.9"
  }
}
